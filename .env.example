NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Translation API (optional — app runs in demo mode without this)
# Option 1: LibreTranslate (self-hosted or public instance)
LIBRETRANSLATE_API_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=your-libretranslate-key

# Option 2: Google Cloud Translation API
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key

# Map config (optional — OpenStreetMap is used by default, no key needed)
# Mapbox API key (if switching to Mapbox tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Push notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@safewander.com

# Email notifications (optional — for SOS alerts to emergency contacts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@safewander.com
